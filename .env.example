# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values for local development.
# Never commit the real .env — it is listed in .gitignore.
#
# AWS deployment: set these values via one of:
#   • AWS Systems Manager Parameter Store  (recommended for production)
#   • AWS Secrets Manager
#   • Elastic Beanstalk → Configuration → Software → Environment properties
#   • ECS Task Definition → Environment variables (reference Secrets Manager ARNs)
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
# AWS EB / ECS typically uses PORT=8080; the app reads process.env.PORT automatically
NODE_ENV=development          # production | development

# CORS — allowed frontend origins are hardcoded in src/app.js:
#   https://techbigsolutions.in
#   https://www.techbigsolutions.in

# ── Database (MySQL / Amazon RDS / Aurora MySQL) ──────────────────────────────
# Local dev: use localhost
# AWS prod:  use your RDS endpoint (e.g. mydb.xxxx.us-east-1.rds.amazonaws.com)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=techbigsols
DB_CONNECTION_LIMIT=10
# SSL options:
#   "false"  — local dev without SSL
#   "true"   — SSL on, no strict cert verification (RDS default — use this)
#   "reject" — strict cert verification (requires valid CA cert)
DB_SSL=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# ── Run database migrations ───────────────────────────────────────────────────
# npm run migrate

# Dependencies
node_modules/

# Environment secrets — never commit real values
.env
.env.local
.env.*.local

# Logs
*.log
logs/
npm-debug.log*

# OS / editor artefacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build output (if added later)
dist/
build/

# EB CLI workspace state — machine-specific, not needed in git
# config.yml is safe to commit (no secrets); the rest is not
.elasticbeanstalk/*
!.elasticbeanstalk/config.yml


# ── Process & proxy configuration (Amazon Linux 2023 compatible) ─────────────
# NodeCommand and NodeVersion are NOT valid on AL2023.
# The start command is read from Procfile: web: node src/server.js
# The Node.js version is selected on the EB Console / eb create --platform flag.

option_settings:

  # ── nginx reverse proxy ───────────────────────────────────────────────────
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx

  # ── Target group / process settings ─────────────────────────────────────
  aws:elasticbeanstalk:environment:process:default:
    Port: "8080"
    Protocol: HTTP
    StickinessEnabled: "false"
    # Gives in-flight requests time to finish before an instance is removed
    # during a rolling deploy or auto-scaling scale-in event.
    DeregistrationDelay: "20"
    HealthCheckPath: /
    MatcherHTTPCode: "200"

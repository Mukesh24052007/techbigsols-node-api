# ── Node.js process configuration ────────────────────────────────────────────
# Tells EB how to start the app and where to find it.

option_settings:
  aws:elasticbeanstalk:container:nodejs:
    NodeCommand: "node src/server.js"

  # Increase idle timeout to handle long DB queries / file uploads gracefully
  aws:elasticbeanstalk:environment:process:default:
    Port: 8080
    StickinessEnabled: false

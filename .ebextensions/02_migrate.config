# ── Database migration + seed on deploy ──────────────────────────────────────
# Both commands run on the leader instance only (leader_only: true).
# Safe to run on every deploy:
#   - migrate.js  — all tables use CREATE TABLE IF NOT EXISTS; all ALTER TABLE
#                   steps are gated with INFORMATION_SCHEMA checks.
#   - seed.js     — checks for existing rows before inserting; fully idempotent.
#                   Exits silently if SEED_ADMIN_EMAIL is not set.
#
# Set seed credentials once via eb setenv (never commit them):
#   eb setenv SEED_ADMIN_NAME="Super Admin" \
#             SEED_ADMIN_EMAIL="admin@techbigsolutions.in" \
#             SEED_ADMIN_PASSWORD="YourStrongPassword123!"
#
# After the first successful deploy you can remove SEED_ADMIN_* from eb setenv
# if you prefer — the seed will simply skip on future deploys.

container_commands:
  01_run_migrations:
    command: "node src/config/migrate.js"
    leader_only: true

  02_run_seed:
    command: "node src/config/seed.js"
    leader_only: true

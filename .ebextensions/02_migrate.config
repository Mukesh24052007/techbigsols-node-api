# ── Database migration on deploy ─────────────────────────────────────────────
# Runs once per deployment on the leader instance only (leader_only: true).
# Safe to keep permanently — every CREATE TABLE uses IF NOT EXISTS and every
# ALTER TABLE step is gated with an INFORMATION_SCHEMA check.
#
# Execution order:
#   container_commands run AFTER app code is unpacked but BEFORE the new
#   version is swapped live — schema is always up to date before traffic arrives.
#
# Environment variables:
#   EB injects all `eb setenv` values as real shell env vars for the duration
#   of the container_commands phase, so DB_HOST, DB_USER, etc. are available
#   automatically. No .env file is needed or expected on the instance.

container_commands:
  01_run_migrations:
    command: "node src/config/migrate.js"
    leader_only: true

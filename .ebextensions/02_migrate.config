# ── Database migration on deploy ─────────────────────────────────────────────
# Runs "npm run migrate" once per deployment on the leader instance only.
# This is safe to keep permanently — every table uses CREATE TABLE IF NOT EXISTS.
#
# Execution order: container_commands run AFTER the app code is deployed
# but BEFORE the new app version is swapped in — so the schema is always
# updated before traffic hits the new code.

container_commands:
  01_run_migrations:
    command: "node src/config/migrate.js"
    leader_only: true   # runs on exactly one instance per deploy
    env:
      NODE_ENV: production

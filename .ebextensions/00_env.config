# ── Elastic Beanstalk environment configuration ───────────────────────────────
# Safe to commit — no secrets here.
# Secrets (DB_PASSWORD, JWT_SECRET, etc.) are set via:
#   eb setenv KEY=value
# or the EB Console → Configuration → Software → Environment properties.

option_settings:

  # ── Application environment variables ──────────────────────────────────────
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: "8080"               # nginx on EB proxies :80/:443 → :8080
    DB_PORT: "3306"
    DB_SSL: "true"             # RDS requires SSL; set to "false" only for local dev
    DB_CONNECTION_LIMIT: "10"
    JWT_EXPIRES_IN: "1d"
    # ALLOWED_ORIGINS — set via eb setenv (comma-separated frontend URLs)
    # DB_HOST        — set via eb setenv (your RDS endpoint)
    # DB_USER        — set via eb setenv
    # DB_PASSWORD    — set via eb setenv
    # DB_NAME        — set via eb setenv
    # JWT_SECRET     — set via eb setenv (openssl rand -hex 64)

  # ── Health check ────────────────────────────────────────────────────────────
  # Using / (root) because EB's default ALB health check hits the root path.
  # The root route in app.js returns 200 OK JSON.
  # /api/health is also available for detailed monitoring / uptime checks.
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /

  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /
    MatcherHTTPCode: "200"
    Port: "8080"
    Protocol: HTTP
    StickinessEnabled: "false"

  # ── Load balancer type ──────────────────────────────────────────────────────
  aws:elasticbeanstalk:environment:
    LoadBalancerType: application

  # ── ALB HTTP listener (:80) — always on ────────────────────────────────────
  aws:elbv2:listener:80:
    ListenerEnabled: "true"
    Protocol: HTTP

  # ── ALB HTTPS listener (:443) ───────────────────────────────────────────────
  # Disabled until you attach an ACM certificate.
  # To enable:
  #   1. Request a cert in ACM for api.yourdomain.com
  #   2. Replace CHANGE_TO_YOUR_ACM_ARN below with the certificate ARN
  #   3. Flip ListenerEnabled to "true"
  #   4. Run: eb deploy
  aws:elbv2:listener:443:
    ListenerEnabled: "false"
    Protocol: HTTPS
    SSLCertificateArns: CHANGE_TO_YOUR_ACM_ARN

  # ── Auto Scaling ────────────────────────────────────────────────────────────
  aws:autoscaling:asg:
    MinSize: "1"
    MaxSize: "3"

  aws:autoscaling:launchconfiguration:
    InstanceType: t3.small
    # EC2 instance profile — EB creates this automatically (aws-elasticbeanstalk-ec2-role)
    IamInstanceProfile: aws-elasticbeanstalk-ec2-role

# ── Elastic Beanstalk environment configuration ───────────────────────────────
# Values marked "CHANGE_ME" must be overridden in the EB environment settings
# (Console → Configuration → Software → Environment properties) or via the
# AWS Systems Manager Parameter Store / Secrets Manager integration.
# Never commit real secrets to this file.

option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080                      # EB forwards external :80 → container :8080 by default

    # ── Database ────────────────────────────────────────────────────────────
    DB_HOST: CHANGE_ME              # e.g. your RDS endpoint or Aurora cluster URL
    DB_PORT: "3306"
    DB_USER: CHANGE_ME
    DB_PASSWORD: CHANGE_ME          # prefer Parameter Store reference in production
    DB_NAME: CHANGE_ME
    DB_SSL: "true"
    DB_CONNECTION_LIMIT: "10"

    # ── Auth ────────────────────────────────────────────────────────────────
    JWT_SECRET: CHANGE_ME           # generate with: openssl rand -hex 64
    JWT_EXPIRES_IN: "1d"

    # ── CORS ────────────────────────────────────────────────────────────────
    # Comma-separated list of allowed frontend origins
    ALLOWED_ORIGINS: CHANGE_ME      # e.g. https://yourapp.com,https://www.yourapp.com

  # ── Node.js platform settings ───────────────────────────────────────────────
  aws:elasticbeanstalk:container:nodejs:
    NodeVersion: 20
    ProxyServer: nginx              # nginx reverse proxy in front of Node

  # ── Health check ────────────────────────────────────────────────────────────
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/health

  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
    MatcherHTTPCode: 200

  # ── Load balancer ───────────────────────────────────────────────────────────
  aws:elasticbeanstalk:environment:
    LoadBalancerType: application   # ALB — supports path-based routing & HTTPS

  aws:elbv2:listener:443:
    ListenerEnabled: false          # flip to true once you attach an ACM certificate
    Protocol: HTTPS
    SSLCertificateArns: CHANGE_ME   # arn:aws:acm:<region>:<account>:certificate/<id>

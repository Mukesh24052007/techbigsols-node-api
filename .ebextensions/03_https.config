# ── HTTPS redirect (HTTP → HTTPS) ────────────────────────────────────────────
# This config adds an nginx rule that redirects all plain HTTP traffic to HTTPS.
#
# HOW TO ACTIVATE:
#   1. Ensure your ACM certificate is Issued (see 00_env.config).
#   2. Flip the :443 listener to ListenerEnabled: "true" in 00_env.config.
#   3. Uncomment the files block below.
#   4. Run: eb deploy
#
# While the :443 listener is disabled, leave this file as-is —
# the commented block has no effect.

# ── Uncomment when HTTPS is live ─────────────────────────────────────────────
# files:
#   "/etc/nginx/conf.d/https_redirect.conf":
#     mode: "000644"
#     owner: root
#     group: root
#     content: |
#       # Redirect HTTP → HTTPS at the nginx layer (before EB health checks)
#       # EB ALB also handles this redirect — having both is fine and idempotent.
#       if ($http_x_forwarded_proto != "https") {
#         return 301 https://$host$request_uri;
#       }
#
# container_commands:
#   01_reload_nginx:
#     command: "service nginx reload || true"
